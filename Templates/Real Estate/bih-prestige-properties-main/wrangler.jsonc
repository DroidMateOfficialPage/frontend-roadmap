{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bih-prestige-properties",
	"main": "dist/server/server.js",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS"
	},
	"build": {
		"command": "vite build"
	}
}
